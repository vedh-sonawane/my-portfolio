# Read-only GitHub Personal Access Token (classic) with NO scopes selected,
# or a fine-grained token with only "Public Repositories (read-only)" access.
# Required for the contribution calendar (GitHub only exposes it via authenticated GraphQL).
# The site still builds and renders without it, and falls back to the values in data/content.ts.
GITHUB_TOKEN=

# OPTIONAL. The GitHub login to pull live data for.
# Leave unset and it uses identity.githubLogin from data/content.ts.
GITHUB_LOGIN=

# OPTIONAL. Canonical site URL for metadata, canonical links, Open Graph and
# the sitemap. Leave unset on Vercel and it uses the project's production
# domain automatically. Set it once you attach a custom domain.
NEXT_PUBLIC_SITE_URL=
